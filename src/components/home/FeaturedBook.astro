---
import { getBook } from "../../data/books";

const book = await getBook("debts-owed");
if (!book) throw new Error("Featured book 'debts-owed' not found");

const featuredQuotes = [
    {
        quote: "An intelligent and intriguing story about love, loyalty and courage. I can almost see the Netflix movie as it unfolds in eight episodes against an all-too-true World War II historical backdrop.",
        attribution: "Steve Berry, <em>New York Times</em> and Internationally Bestselling Author",
    },
    {
        quote: "Espionage with real emotional stakes…Glenn Dyer brings occupied Paris to life in this atmospheric World War II stunner. If you haven’t read the Conor Thorn series, you’re missing out. <em>Debts Owed</em> pays off—big time.",
        attribution: "Alex Finlay, Bestselling Author of <em>The Anniversary</em>",
    },
    {
        quote: "In the spirit of W.E.B. Griffin's catalog of military history and period pieces, and Kristin Hannah's character-driven story, <em>The Nightingale</em>…",
        attribution: "Chanticleer Book Reviews – Five-Star Review",
    },
    {
        quote: "…this is a gripping, well-paced thriller led by a pair of compelling agents and a nail-biting plot, which further establishes the Conor Thorn series as a standout in the genre.",
        attribution: "The Independent Review of Books",
    },
];
---

<section class="pt-[200px] pb-[120px] bg-surface-container-low">
    <div class="max-w-[1296px] mx-auto px-4 md:px-8 lg:px-16">
        <div class="flex items-center gap-4 mb-16">
            <div class="w-10 h-0.5 bg-secondary"></div>
            <span
                class="font-label-caps text-label-caps text-secondary tracking-widest"
                >LATEST RELEASE</span
            >
        </div>

        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center">
            <div class="col-span-12 md:col-span-5">
                <div class="relative inline-block hard-shadow">
                    <img
                        class="w-full aspect-[2/3] object-cover"
                        src={book.coverImage}
                        alt={`${book.title} book cover`}
                    />
                    <div
                        class="absolute top-0 left-0 bg-secondary text-white px-4 py-2 font-label-caps text-[10px] tracking-widest"
                    >
                        BOOK {book.number}
                    </div>
                </div>
            </div>

            <div
                class="col-span-12 md:col-span-6 md:col-start-7 flex flex-col justify-center"
            >
                <p
                    class="font-label-caps text-label-caps text-secondary mb-3 tracking-widest"
                >
                    THE CONOR THORN SERIES
                </p>
                <h2
                    class="font-headline-lg text-headline-lg text-primary font-bold mb-2 tracking-tight"
                >
                    {book.title}
                </h2>
                <p
                    class="font-headline-md text-xl text-on-surface-variant font-normal mb-8"
                >
                    by Glenn Dyer
                </p>

                <div class="w-10 h-0.5 bg-secondary mb-8"></div>

                <p
                    class="font-body-lg text-body-lg text-on-surface-variant mb-6 leading-relaxed"
                >
                    {book.briefDescription}
                </p>
                <div class="flex flex-col gap-6 mb-10">
                    {featuredQuotes.map((q) => (
                        <blockquote class="border-l-2 border-secondary pl-4">
                            <p class="font-body-lg text-body-lg text-zinc-400 italic">
                                &ldquo;<Fragment set:html={q.quote} />&rdquo;
                            </p>
                            <footer class="font-label-caps text-sm text-on-surface-variant mt-2">
                                —<Fragment set:html={q.attribution} />
                            </footer>
                        </blockquote>
                    ))}
                </div>

                <div class="flex flex-wrap gap-3">
                    <a
                        href={book.buyLink || "#order"}
                        target={book.buyLink ? "_blank" : undefined}
                        rel={book.buyLink ? "noopener noreferrer" : undefined}
                        class="bg-secondary text-white px-8 py-3 font-label-caps text-label-caps tracking-widest hover:bg-on-surface hover:text-background transition-colors"
                        >BUY NOW</a
                    >
                    <a
                        href={`/books/${book.id}`}
                        class="border border-outline-variant text-on-surface-variant px-8 py-3 font-label-caps text-label-caps tracking-widest hover:border-primary hover:text-primary transition-colors"
                        >LEARN MORE</a
                    >
                </div>
            </div>
        </div>
    </div>
</section>
