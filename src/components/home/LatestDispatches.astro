---
import { getNewsletterPosts } from '../../data/newsletter';

const posts = await getNewsletterPosts();
const [featured, ...rest] = posts;
const sidebarArticles = rest.slice(0, 3);
---

<section class="py-[120px] bg-surface">
    <div class="max-w-[1296px] mx-auto px-4 md:px-8 lg:px-16">
        <div class="flex flex-wrap justify-between items-center gap-4 mb-16">
            <div class="flex items-center gap-4">
                <div class="w-10 h-0.5 bg-secondary shrink-0"></div>
                <h2
                    class="font-headline-md text-xl md:text-headline-md text-primary font-bold tracking-tight"
                >
                    NEWS & EVENTS
                </h2>
            </div>
            <a
                href="/newsletter"
                class="font-label-caps text-label-caps text-secondary tracking-widest hover:text-on-surface transition-colors"
            >
                VIEW ALL →
            </a>
        </div>

        <div class="grid grid-cols-12 gap-4 md:gap-8">
            {
                featured && (
                    <a
                        href="/newsletter"
                        class="col-span-12 lg:col-span-8 group cursor-pointer"
                    >
                        <div class="relative overflow-hidden mb-6">
                            <img
                                class="w-full aspect-video object-cover filter transition-all duration-700"
                                src={featured.image}
                                alt={featured.imageAlt}
                            />
                        </div>
                        <span class="font-data-mono text-data-mono text-secondary mb-2 block tracking-widest">
                            {[featured.displayDate, featured.category]
                                .filter(Boolean)
                                .join(" · ")}
                        </span>
                        <h3 class="font-headline-md text-headline-md text-primary font-bold mb-4 group-hover:text-secondary transition-colors tracking-tight">
                            {featured.title}
                        </h3>
                        <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl leading-relaxed line-clamp-3">
                            {featured.excerpt}
                        </p>
                    </a>
                )
            }

            <div class="col-span-12 lg:col-span-4 flex flex-col gap-10">
                {
                    sidebarArticles.map((post, i) => (
                        <a
                            href="/newsletter"
                            class={`group cursor-pointer ${i < sidebarArticles.length - 1 ? "border-b border-outline-variant pb-10" : ""}`}
                        >
                            <span class="font-data-mono text-data-mono text-secondary mb-2 block tracking-widest">
                                {post.displayDate}
                            </span>
                            <h4 class="font-headline-md text-lg text-primary font-bold mb-2 group-hover:text-secondary transition-colors">
                                {post.title}
                            </h4>
                            <p class="font-body-md text-sm text-on-surface-variant leading-relaxed line-clamp-3">
                                {post.excerpt}
                            </p>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>
