---
const books = [
    {
        year: "2018",
        label: "BOOK ONE",
        labelColor: "text-secondary",
        dotColor: "bg-secondary",
        title: "The Torch Betrayal",
        description:
            "The debut Conor Thorn novel. When the plans for Operation Torch—the Allied invasion of North Africa—go missing, Thorn races to find the traitor before the invasion is compromised.",
        showLine: true,
    },
    {
        year: "2020",
        label: "BOOK TWO",
        labelColor: "text-secondary",
        dotColor: "bg-zinc-500",
        title: "The Ultra Betrayal",
        description:
            "When the Allies' most closely guarded secret—the Ultra decryption program—is threatened by a double agent, Thorn must penetrate Nazi-controlled Europe to prevent catastrophe.",
        showLine: true,
    },
    {
        year: "2021",
        label: "BOOK THREE",
        labelColor: "text-secondary",
        dotColor: "bg-zinc-500",
        title: "The Unquiet Genius",
        description:
            "A brilliant nuclear scientist with knowledge that could change the outcome of the war has vanished. Conor and Emily Thorn’s mission: find him before the Germans do.",
        showLine: true,
    },
    {
        year: "2023",
        label: "BOOK FOUR",
        labelColor: "text-secondary",
        dotColor: "bg-zinc-500",
        title: "Trust No One",
        description:
            "After being dismissed from the OSS and MI6, respectively, Conor and Emily Thorn plunge into a dangerous mission in Algiers and southern France to expose a secret archive threatening Allied unity.",
        showLine: true,
    },
    {
        year: "2026",
        label: "BOOK FIVE",
        labelColor: "text-secondary",
        dotColor: "bg-secondary",
        title: "Debts Owed",
        description:
            "The latest heart-pounding installment in the Conor Thorn series will be released November 1st!",
        buyLink:
            "https://www.amazon.com/Debts-Owed-World-Espionage-Thriller-ebook/dp/B0HJRXW4VQ/ref=sr_1_4?crid=UYJJ6EJ0GFNV&dib=eyJ2IjoiMSJ9.wSod6_Wfe-aZ0OuwlXWPAnN7IDb1I7Z4HsfNSF4glzs1FnD73Z5CElx-Ob3zrBVxUdIBMGL4PkhXz8eUGb91_odsw-ZobDR9KbJGOiZDEMPeLgkbv-sBesKWyNoRQkmlhXnFJXZ-9U9FB61Rvx-3VCAma2QXgeBV6wT9xVF48kvX0vxD-Xn52Xv7LaaeMnugwvXZcieVg19rwf_FurvLPIcjC9jE2XEg2M7mxwWIZgQ.2fTe5CZZ5rJgNgGuNN7RSPsnA68Bb8aUn6BOq6sUPHY&dib_tag=se&keywords=glenn+dyer&qid=1789775175&s=books&sprefix=glenn+dyer%2Cstripbooks%2C201&sr=1-4",
        showLine: false,
