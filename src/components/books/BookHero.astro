---
import type { Book } from "../../data/books";

interface Props {
    book: Book;
}

const { book } = Astro.props;

function getYouTubeId(url?: string): string | null {
    if (!url) return null;
    const match = url.match(/(?:v=|youtu\.be\/)([\w-]{11})/);
    return match ? match[1] : null;
}

const trailerId = getYouTubeId(book.trailerUrl);
const trailerDialogId = `trailer-${book.id}`;
---

<section
    class="max-w-[1296px] mx-auto px-4 md:px-8 lg:px-16 grid grid-cols-12 gap-4 md:gap-8 mb-[120px]"
>
    <div class="col-span-12 lg:col-span-5">
        <div class="hard-shadow">
            <img
                class="w-full aspect-[2/3] object-cover"
                src={book.coverImage}
                alt={`${book.title} book cover`}
            />
        </div>
        <div
            class="mt-6 flex items-center justify-between font-label-caps text-label-caps text-secondary tracking-widest border-b border-outline-variant pb-4"
        >
            <span>THE CONOR THORN SERIES</span>
            <span>BOOK {book.number}</span>
        </div>
    </div>

    <div
        class="col-span-12 lg:col-span-7 lg:pl-12 flex flex-col justify-center"
    >
        <div class="flex items-center gap-4 mb-6">
            <div class="w-10 h-0.5 bg-secondary"></div>
            <span
                class="font-label-caps text-base text-secondary tracking-widest"
                >{book.genre}</span
            >
        </div>
        <h1
            class="font-headline-xl text-headline-xl text-primary font-bold tracking-tight mb-3"
        >
            {book.title}
        </h1>
        <p
            class="font-headline-md text-xl text-on-surface-variant font-normal mb-10"
        >
            by Glenn Dyer
        </p>

        <p
            class="font-body-lg text-body-lg text-on-surface-variant mb-12 leading-relaxed"
        >
            {book.fullDescription}
        </p>

        <div class="flex flex-wrap gap-4">
            <a
                href={book.buyLink || "#order"}
                target={book.buyLink ? "_blank" : undefined}
                rel={book.buyLink ? "noopener noreferrer" : undefined}
                class="bg-secondary text-white px-10 py-4 font-label-caps text-label-caps tracking-widest hover:bg-black hover:text-white transition-colors duration-200 flex items-center gap-3"
            >
                {book.isPreOrder ? "PRE-ORDER NOW" : "ORDER NOW"} <span class="material-symbols-outlined text-sm"
                    >shopping_cart</span
                >
            </a>
            {trailerId && (
                <button
                    type="button"
                    data-trailer-open={trailerDialogId}
                    class="border border-outline-variant text-on-surface-variant px-10 py-4 font-label-caps text-label-caps tracking-widest hover:border-primary hover:text-primary transition-colors duration-200 uppercase pt-5"
                >
                    Watch Trailer
                </button>
            )}
        </div>
    </div>

    {trailerId && (
        <dialog
            id={trailerDialogId}
            data-trailer-dialog
            class="backdrop:bg-black/80 bg-transparent p-0 w-[92vw] max-w-3xl m-auto"
        >
            <div class="relative aspect-video w-full">
                <button
                    type="button"
                    data-trailer-close
                    aria-label="Close trailer"
                    class="absolute -top-10 right-0 text-white hover:text-primary transition-colors"
                >
                    <span class="material-symbols-outlined">close</span>
                </button>
                <iframe
                    class="w-full h-full"
                    src={`https://www.youtube-nocookie.com/embed/${trailerId}`}
                    title={`${book.title} trailer`}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                ></iframe>
            </div>
        </dialog>
    )}
</section>

<script>
    function initTrailerDialogs() {
        document.querySelectorAll<HTMLButtonElement>("[data-trailer-open]").forEach((btn) => {
            const dialog = document.getElementById(
                btn.dataset.trailerOpen ?? "",
            ) as HTMLDialogElement | null;
            if (!dialog) return;
            btn.addEventListener("click", () => dialog.showModal());
        });

        document.querySelectorAll<HTMLDialogElement>("[data-trailer-dialog]").forEach((dialog) => {
            const iframe = dialog.querySelector("iframe");
            const closeBtn = dialog.querySelector<HTMLButtonElement>("[data-trailer-close]");

            closeBtn?.addEventListener("click", () => dialog.close());

            dialog.addEventListener("click", (e) => {
                if (e.target === dialog) dialog.close();
            });

            dialog.addEventListener("close", () => {
                if (iframe) iframe.src = iframe.src;
            });
        });
    }

    initTrailerDialogs();
    document.addEventListener("astro:page-load", initTrailerDialogs);
</script>
