---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';
import { getBlogPosts, getBlogPostContent } from '../../data/blog';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const contentHtml = await getBlogPostContent(post.slug);
---

<Layout
  title={`${post.title} | Glenn Dyer`}
  description={post.excerpt}
>
  <NavBar activePage="blog" />

  <main class="max-w-[900px] mx-auto px-4 md:px-8 lg:px-16 py-24 mt-20">
    <a
      href="/blog"
      class="font-label-caps text-label-caps text-secondary tracking-widest hover:text-on-surface transition-colors mb-8 inline-block"
    >
      ← BACK TO BLOG
    </a>

    <div class="flex items-center gap-3 mb-6">
      {post.category && (
        <>
          <span class="w-1.5 h-1.5 bg-secondary rounded-full"></span>
          <p class="font-label-caps text-label-caps text-secondary tracking-widest">{post.category}</p>
        </>
      )}
      <p class="ml-auto font-data-mono text-data-mono text-on-surface-variant">{post.displayDate}</p>
    </div>

    <h1 class="font-headline-xl text-headline-xl text-primary font-bold tracking-tight mb-10">
      {post.title}
    </h1>

    {post.image && (
      <div class="aspect-video overflow-hidden mb-10 hard-shadow-sm">
        <img
          src={post.image}
          alt={post.imageAlt}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <div
      class="post-content font-body-lg text-body-lg text-on-surface-variant leading-relaxed"
      set:html={contentHtml}
    />
  </main>

  <div class="max-w-[1280px] mx-auto px-4 md:px-8 lg:px-16">
    <NewsletterCTA />
  </div>

  <Footer />
</Layout>

<style>
  .post-content :global(p) {
    margin-block: 1.5rem;
  }
  .post-content :global(p:first-child) {
    margin-top: 0;
  }
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    color: var(--color-primary);
    font-weight: 700;
    line-height: 1.2;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .post-content :global(h2) {
    font-size: 1.75rem;
  }
  .post-content :global(h3) {
    font-size: 1.375rem;
  }
  .post-content :global(a) {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-content :global(a:hover) {
    color: var(--color-on-surface);
  }
  .post-content :global(strong) {
    color: var(--color-on-surface);
    font-weight: 700;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin-block: 1.5rem;
    padding-left: 1.5rem;
  }
  .post-content :global(ul) {
    list-style: disc;
  }
  .post-content :global(ol) {
    list-style: decimal;
  }
  .post-content :global(li) {
    margin-block: 0.5rem;
  }
  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-secondary);
    padding-left: 1.25rem;
    margin-block: 1.75rem;
    font-style: italic;
    color: var(--color-on-surface);
  }
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    margin-block: 2rem;
  }
  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-outline-variant);
    margin-block: 2.5rem;
  }
</style>
